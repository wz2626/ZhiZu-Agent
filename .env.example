# 已验证的双平台组合：DeepSeek 官方聊天 + 硅基流动向量。
# 复制为 .env 后分别填写两家平台的 Key；不要提交 .env。
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=your_deepseek_api_key_here
# DeepSeek 默认思考模式的样例耗时约 26 秒；代码默认 20，此组合建议 60。
# 允许范围 1-120 秒；这是网络超时配置，不是整个请求的硬性截止时间。
CHAT_TIMEOUT_SECONDS=60

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=your_siliconflow_api_key_here

# 与 Mock 库隔离；入库与 API 必须使用相同路径、模型和维度。
CHROMA_PATH=./.runtime/chroma_cloud
